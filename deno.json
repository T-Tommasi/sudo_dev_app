{
  "workspace": [
    "./packages/core",
    "./packages/sdk",
    "./packages/tui"
  ],
  "importMap": "import_map.json",
  "tasks": {
    "test": "deno test --allow-all",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true
  }
}
